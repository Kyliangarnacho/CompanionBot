<?xml version="1.0"?>
<package format="3">
  <name>companionbot_ros</name><version>0.9.0</version>
  <description>Thin ROS adapters around existing CompanionBot runtimes</description>
  <maintainer email="maintainer@companionbot.local">CompanionBot</maintainer>
  <license>LicenseRef-CompanionBot</license>
  <exec_depend>rclpy</exec_depend><exec_depend>companionbot_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend><exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
