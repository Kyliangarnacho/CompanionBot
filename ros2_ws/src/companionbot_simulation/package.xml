<?xml version="1.0"?>
<package format="3">
  <name>companionbot_simulation</name>
  <version>0.9.1</version>
  <description>MuJoCo plant, synthetic sensors and frozen scenario composition</description>
  <maintainer email="maintainer@companionbot.local">CompanionBot</maintainer>
  <license>LicenseRef-CompanionBot</license>
  <exec_depend>companionbot_interfaces</exec_depend>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
