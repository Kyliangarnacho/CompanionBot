Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Ground
    Enabled: true
    Cell Size: 0.25
  - Class: rviz_default_plugins/Map
    Name: Saved map / AMCL localization
    Enabled: true
    Topic:
      Value: /map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Alpha: 0.7
  - Class: rviz_default_plugins/RobotModel
    Name: Balancing Body
    Enabled: true
    Description Source: Topic
    Description Topic:
      Value: /companionbot/robot_description
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/TF
    Name: Frames
    Enabled: true
  - Class: rviz_default_plugins/LaserScan
    Name: Physical Tilted Scan
    Enabled: true
    Topic:
      Value: /companionbot/scan
      Reliability Policy: Best Effort
    Size (m): 0.015
    Style: Points
  - Class: rviz_default_plugins/Odometry
    Name: Estimated Planar Odometry
    Enabled: true
    Topic:
      Value: /companionbot/odom
      Reliability Policy: Best Effort
    Keep: 100
  - Class: rviz_default_plugins/Path
    Name: Global path
    Enabled: true
    Topic:
      Value: /plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Alpha: 0.5
  - Class: rviz_default_plugins/Path
    Name: Local path
    Enabled: true
    Topic:
      Value: /received_global_plan
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Alpha: 0.5
  - Class: rviz_default_plugins/Map
    Name: Global costmap
    Enabled: true
    Topic:
      Value: /global_costmap/costmap
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Alpha: 0.5
  - Class: rviz_default_plugins/Map
    Name: Local costmap
    Enabled: true
    Topic:
      Value: /local_costmap/costmap
      Reliability Policy: Reliable
      Durability Policy: Volatile
    Alpha: 0.5
  - Class: rviz_default_plugins/MarkerArray
    Name: Versioned navigation destinations
    Enabled: true
    Marker Topic:
      Value: /companionbot/navigation/targets
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Pitch: 0.5
      Yaw: 0.7
Window Geometry:
  Width: 1200
  Height: 800
